{# Ray-walking jump primitives for JPS. Assumes cost is PADDED: size stride*H
   where stride = w+1, H = h+1, and border cells are INF.

   Jump macros start with `idx = node` and operate on flat indices. #}

{# Vertical cardinal jump: dx = 0, dy = dy_expr. Caller provides `node`
   (starting flat index) and `nx` (column, for goal-split and hxh).
   Optional `sdy_expr`: expression for stride_dy (avoids recomputing `dy * stride`). #}
{% import '_macros.j2' as _m -%}
{% macro jump_v(dy_expr, parent_expr, push_line, sdy_expr=None) -%}
dist = 0
stride_dy = {{ sdy_expr if sdy_expr else _m.mul(dy_expr, 'stride') }}
yp_xm_off = stride_dy - 1
yp_xp_off = stride_dy + 1
idx = node
if nx == gx:
    while True:
        idx += stride_dy
        dist += 1
        if cost[idx] is inf:
            dist = -1
            break
        if (
            idx == goal
            or (cost[idx - 1] is inf and cost[idx + yp_xm_off] is not inf)
            or (cost[idx + 1] is inf and cost[idx + yp_xp_off] is not inf)
        ):
            break
else:
    while True:
        idx += stride_dy
        dist += 1
        if cost[idx] is inf:
            dist = -1
            break
        if (cost[idx - 1] is inf and cost[idx + yp_xm_off] is not inf) or (
            cost[idx + 1] is inf and cost[idx + yp_xp_off] is not inf
        ):
            break
if dist > 0:
    nd = g_node + dist
    if nd < g[idx]:
        g[idx] = nd
        parent[idx] = {{ parent_expr }}
        entry_dir[idx] = {{ dy_expr }} + 4  # encodes (0, dy): (dx+1)*3 + (dy+1)
        hxh = abs(nx - gx)
        hyh = abs((idx // stride) - gy)
        {{ push_line }}
{%- endmacro %}

{# Horizontal cardinal jump: dx = dx_expr, dy = 0. Caller provides `node`
   and `ny` (for goal-split and hyh).
   dx_expr is always a simple literal or variable name (no caller uses a compound expr). #}
{% macro jump_h(dx_expr, parent_expr, push_line) -%}
dist = 0
up_dx_off = {{ dx_expr }} - stride
dn_dx_off = stride + {{ dx_expr }}
idx = node
if ny == gy:
    while True:
        idx += {{ dx_expr }}
        dist += 1
        if cost[idx] is inf:
            dist = -1
            break
        if (
            idx == goal
            or (cost[idx - stride] is inf and cost[idx + up_dx_off] is not inf)
            or (cost[idx + stride] is inf and cost[idx + dn_dx_off] is not inf)
        ):
            break
else:
    while True:
        idx += {{ dx_expr }}
        dist += 1
        if cost[idx] is inf:
            dist = -1
            break
        if (cost[idx - stride] is inf and cost[idx + up_dx_off] is not inf) or (
            cost[idx + stride] is inf and cost[idx + dn_dx_off] is not inf
        ):
            break
if dist > 0:
    nd = g_node + dist
    if nd < g[idx]:
        g[idx] = nd
        parent[idx] = {{ parent_expr }}
        entry_dir[idx] = 3 * {{ dx_expr }} + 4  # encodes (dx, 0): (dx+1)*3 + 1
        hxh = abs((idx % stride) - gx)
        hyh = abs(ny - gy)
        {{ push_line }}
{%- endmacro %}

{# Diagonal jump: dx = dx_expr, dy = dy_expr, both nonzero.
   Optional `sdy_expr`: expression for stride_dy (avoids recomputing `dy * stride`).
   dx_expr must be a simple literal or variable name (dx is used in hot loop).
   Callers using a compound expression must precompute it to a local and pass the name. #}
{% macro jump_d(dx_expr, dy_expr, parent_expr, push_line, sdy_expr=None) -%}
dist = 0
stride_dy = {{ sdy_expr if sdy_expr else _m.mul(dy_expr, 'stride') }}
step = stride_dy + {{ dx_expr }}
# Forced-neighbor offsets (main diagonal loop):
fwd_yx_off = stride_dy - {{ dx_expr }}    # (x-dx, y+dy) from idx
back_xy_off = {{ dx_expr }} - stride_dy   # (x+dx, y-dy) from idx
# Sub-scan (dx, 0) offsets: perpendicular rows y±1.
sub_up_dx_off = {{ dx_expr }} - stride
sub_dn_dx_off = stride + {{ dx_expr }}
# Sub-scan (0, dy) offsets: perpendicular cols x±1, one step along dy.
sub_yp_xm_off = stride_dy - 1
sub_yp_xp_off = stride_dy + 1
idx = node
subfound = False  # hoisted: re-entry to each sub-scan always sees False (if True we'd have broken out already)
while True:
    idx += step
    dist += 1
    if cost[idx] is inf:
        dist = -1
        break
    if (
        idx == goal
        or (cost[idx - {{ dx_expr }}] is inf and cost[idx + fwd_yx_off] is not inf)
        or (cost[idx - stride_dy] is inf and cost[idx + back_xy_off] is not inf)
    ):
        break
    # Sub-scan cardinal (dx, 0) from idx: y is fixed here.
    cidx = idx
    while True:
        cidx += {{ dx_expr }}
        if cost[cidx] is inf:
            break
        if (
            cidx == goal
            or (cost[cidx - stride] is inf and cost[cidx + sub_up_dx_off] is not inf)
            or (cost[cidx + stride] is inf and cost[cidx + sub_dn_dx_off] is not inf)
        ):
            subfound = True
            break
    if subfound:
        break
    # Sub-scan cardinal (0, dy) from idx: x is fixed here.
    cidx = idx
    while True:
        cidx += stride_dy
        if cost[cidx] is inf:
            break
        if (
            cidx == goal
            or (cost[cidx - 1] is inf and cost[cidx + sub_yp_xm_off] is not inf)
            or (cost[cidx + 1] is inf and cost[cidx + sub_yp_xp_off] is not inf)
        ):
            subfound = True
            break
    if subfound:
        break
if dist > 0:
    nd = g_node + dist
    if nd < g[idx]:
        g[idx] = nd
        parent[idx] = {{ parent_expr }}
        entry_dir[idx] = 3 * {{ dx_expr }} + {{ dy_expr }} + 4  # (dx+1)*3 + (dy+1)
        hxh = abs((idx % stride) - gx)
        hyh = abs((idx // stride) - gy)
        {{ push_line }}
{%- endmacro %}
