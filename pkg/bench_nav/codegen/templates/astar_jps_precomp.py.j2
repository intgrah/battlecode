        elif enc == 0:  # NW (dx0=-1, dy0=-1)
            {{ m.expand_diagonal_arrival(prim, 'node', PUSH, '-1', '-1') | indent(12) }}
        elif enc == 7:  # E (dx0=1)
            {{ m.expand_horizontal_arrival(prim, 'node', PUSH, '1') | indent(12) }}
        elif enc == 1:  # W (dx0=-1)
            {{ m.expand_horizontal_arrival(prim, 'node', PUSH, '-1') | indent(12) }}
        elif enc == 3:  # N (dy0=-1)
            {{ m.expand_vertical_arrival(prim, 'node', PUSH, '-1') | indent(12) }}
        elif enc == 5:  # S (dy0=1)
            {{ m.expand_vertical_arrival(prim, 'node', PUSH, '1') | indent(12) }}
    return None


class AstarJpsPrecomp(Spsp):
    REQUIRES = frozenset({COST})

    @override
    def __init__(self, ctx: PrecompCtx) -> None:
        w, h = ctx.w, ctx.h
        cost = ctx[COST]
        stride = w + 1
        n_pad = stride * (h + 1)
        cost_pad = [INF] * n_pad
        for y in range(h):
            for x in range(w):
                cost_pad[y * stride + x] = cost[y * w + x]
        self.w = w
        self.h = h
        self.stride = stride
        self.n_pad = n_pad
        self.cost_pad = cost_pad
        self.jN, self.jNE, self.jE, self.jSE, self.jS, self.jSW, self.jW, self.jNW = (
            _build_tables(w, h, stride, n_pad, cost_pad)
        )

    @override
    def plan(self, start: int, goal: int) -> Path_:
        w = self.w
        sp = (start // w) * self.stride + (start % w)
        gp = (goal // w) * self.stride + (goal % w)
        return astar_jps_precomp(
            self.stride,
            self.n_pad,
            self.cost_pad,
            sp,
            gp,
            w,
            self.jN,
            self.jNE,
            self.jE,
            self.jSE,
            self.jS,
            self.jSW,
            self.jW,
            self.jNW,
        )
