def _reconstruct(
    parent: list[int], start: int, goal: int, stride: int, w: int
) -> list[int]:
    """Rebuild path from parent chain. Indices are padded (stride stride); output
    path uses unpadded stride (w)."""
    chain: list[int] = []
    cur = goal
    while cur != start:
        chain.append(cur)
        cur = parent[cur]
    chain.reverse()
    ax, ay = start % stride, start // stride
    path: list[int] = [ay * w + ax]
    for b in chain:
        bx, by = b % stride, b // stride
        dx = (bx > ax) - (bx < ax)
        dy = (by > ay) - (by < ay)
        while ax != bx or ay != by:
            ax += dx
            ay += dy
            path.append(ay * w + ax)
    return path


def _build_tables(
    w: int, h: int, stride: int, n_pad: int, cost: list[int]
) -> tuple[list[int], list[int], list[int], list[int], list[int], list[int], list[int], list[int]]:
    """Return (jN, jNE, jE, jSE, jS, jSW, jW, jNW) jump tables indexed by direction
    (dx, dy) via the same 8-neighbour convention used elsewhere.

    Cardinal order: N(0,-1), E(1,0), S(0,1), W(-1,0).
    Diagonal order: NE(1,-1), SE(1,1), SW(-1,1), NW(-1,-1).
    """
    inf = INF
    tabs: dict[tuple[int, int], list[int]] = {}

    def cardinal_jp(x: int, y: int, dx: int, dy: int) -> bool:
        for pdx, pdy in ((-dy, dx), (dy, -dx)):
            wx, wy = x + pdx, y + pdy
            bx, by = x + dx + pdx, y + dy + pdy
            if (
                0 <= wx < w
                and 0 <= wy < h
                and 0 <= bx < w
                and 0 <= by < h
                and cost[wy * stride + wx] >= inf
                and cost[by * stride + bx] < inf
            ):
                return True
        return False

    def diagonal_jp(
        x: int, y: int, dx: int, dy: int, hcard: list[int], vcard: list[int]
    ) -> bool:
        t = y * stride + x
        if hcard[t] > 0 or vcard[t] > 0:
            return True
        for (wx_off, wy_off), (px_off, py_off) in (
            ((-dx, 0), (-dx, dy)),
            ((0, -dy), (dx, -dy)),
        ):
            wx, wy = x + wx_off, y + wy_off
            px, py = x + px_off, y + py_off
            if (
                0 <= wx < w
                and 0 <= wy < h
                and 0 <= px < w
                and 0 <= py < h
                and cost[wy * stride + wx] >= inf
                and cost[py * stride + px] < inf
            ):
                return True
        return False

    for dx, dy in ((0, -1), (1, 0), (0, 1), (-1, 0)):
        tab = [0] * n_pad
        step_d = dy * stride + dx
        if dx == 0:
            y_rng = range(h) if dy == -1 else range(h - 1, -1, -1)
            for x in range(w):
                for y in y_rng:
                    t = y * stride + x
                    if cost[t] >= inf:
                        continue
                    fx, fy = x + dx, y + dy
                    if not (0 <= fx < w and 0 <= fy < h):
                        continue
                    f_idx = t + step_d
                    if cost[f_idx] >= inf:
                        continue
                    if cardinal_jp(fx, fy, dx, dy):
                        tab[t] = 1
                    elif tab[f_idx] > 0:
                        tab[t] = tab[f_idx] + 1
        else:
            x_rng = range(w) if dx == -1 else range(w - 1, -1, -1)
            for y in range(h):
                for x in x_rng:
                    t = y * stride + x
                    if cost[t] >= inf:
                        continue
                    fx, fy = x + dx, y + dy
                    if not (0 <= fx < w and 0 <= fy < h):
                        continue
                    f_idx = t + step_d
                    if cost[f_idx] >= inf:
                        continue
                    if cardinal_jp(fx, fy, dx, dy):
                        tab[t] = 1
                    elif tab[f_idx] > 0:
                        tab[t] = tab[f_idx] + 1
        tabs[(dx, dy)] = tab

    for dx, dy in ((1, -1), (1, 1), (-1, 1), (-1, -1)):
        tab = [0] * n_pad
        step_d = dy * stride + dx
        hcard = tabs[(dx, 0)]
        vcard = tabs[(0, dy)]
        y_rng = range(h) if dy == -1 else range(h - 1, -1, -1)
        x_rng = range(w - 1, -1, -1) if dx == 1 else range(w)
        for y in y_rng:
            for x in x_rng:
                t = y * stride + x
                if cost[t] >= inf:
                    continue
                fx, fy = x + dx, y + dy
                if not (0 <= fx < w and 0 <= fy < h):
                    continue
                f_idx = t + step_d
                if cost[f_idx] >= inf:
                    continue
                if diagonal_jp(fx, fy, dx, dy, hcard, vcard):
                    tab[t] = 1
                elif tab[f_idx] > 0:
                    tab[t] = tab[f_idx] + 1
        tabs[(dx, dy)] = tab

    return (
        tabs[(0, -1)],
        tabs[(1, -1)],
        tabs[(1, 0)],
        tabs[(1, 1)],
        tabs[(0, 1)],
        tabs[(-1, 1)],
        tabs[(-1, 0)],
        tabs[(-1, -1)],
    )


def astar_jps_precomp(
    stride: int,
    n: int,
    cost: list[int],
    start: int,
    goal: int,
    w: int,
    jN: list[int],
    jNE: list[int],
    jE: list[int],
    jSE: list[int],
    jS: list[int],
    jSW: list[int],
    jW: list[int],
    jNW: list[int],
) -> Path_:
    """JPS+ with heap, using padded cost grid (stride = w+1) and precomputed
    jump-distance tables."""
    heappush = heapq.heappush
    heappop = heapq.heappop
    inf = INF  # local alias: hot-loop `is inf` is LOAD_FAST vs LOAD_GLOBAL
    gx, gy = goal % stride, goal // stride
    big = n * 64  # heap factor for f; h * n + idx fits below it (h ≤ 63)

    g = [inf] * n
    g[start] = 0
    parent = [-1] * n
    parent[start] = start
    entry_dir = bytearray(n)  # encoding: (dx+1)*3 + (dy+1) ∈ [0, 8]. 0 = unvisited/start
    closed = bytearray(n)
    heap: list[int] = []

    # === Expand start in all 8 directions. ===
    if start == goal:
        return [(start // stride) * w + (start % stride)]
    closed[start] = True
    node = start  # jump macros reference `node` as starting flat index
    nx, ny = start % stride, start // stride
    rx, ry = gx - nx, gy - ny  # goal-relative, hoisted for goal-snap/L-cone
    arx = rx if rx > 0 else -rx  # |rx|, reused as hxh for cardinal verticals
    ary = ry if ry > 0 else -ry  # |ry|, reused as hyh for cardinal horizontals
    g_node = 0  # g[start]
    {{ m.expand_start(prim, 'start', PUSH) | indent(4) }}

    while heap:
        node = heappop(heap) % n
        if closed[node]:
            continue
        if node == goal:
            return _reconstruct(parent, start, goal, stride, w)
        closed[node] = True
        g_node = g[node]
        rx = gx - (node % stride)  # hoisted: used by every diagonal jump
        ry = gy - (node // stride)
        arx = rx if rx > 0 else -rx  # hxh for cardinal verticals (x unchanged)
        ary = ry if ry > 0 else -ry  # hyh for cardinal horizontals (y unchanged)
        enc = entry_dir[node]
        # Monomorphised dispatch: each arrival direction is a specialised block
        # with literal (dx0, dy0) so plus's _tab() resolves to direct table names
        # (jN, jNE, …) instead of the 9-slot `jump_tabs[…]` subscript.
        # Ordered by expected frequency: diagonals first (JPS+ mostly propagates
        # along diagonals), then cardinals. enc=4 never occurs (dx=0, dy=0).
        if enc == 6:  # NE (dx0=1, dy0=-1)
            {{ m.expand_diagonal_arrival(prim, 'node', PUSH, '1', '-1') | indent(12) }}
        elif enc == 8:  # SE (dx0=1, dy0=1)
