{# Shared macros for astar_jps codegen. Assumes cost is PADDED: size stride*H
   where stride = w+1, H = h+1, and border cells (x == w, y == h) are INF.
   This lets us skip all bounds checks: negative indexing wraps to border
   (still INF), and positive overflow hits the last row (also INF).

   Jump macros start with `idx = node` and operate on flat indices. #}

{# Inline ternary max — ~4x faster than max() builtin for 2 args. #}
{% macro max2(a, b) -%}
({{ a }} if {{ a }} > {{ b }} else {{ b }})  # noqa: FURB136
{%- endmacro %}

{# Vertical cardinal jump: dx = 0, dy = dy_expr. Caller provides `node`
   (starting flat index) and `nx` (column, for goal-split and hxh).
   Optional `sdy_expr`: expression for stride_dy (avoids recomputing `dy * stride`). #}
{% macro jump_v(dy_expr, parent_expr, push_line, sdy_expr=None) -%}
dy = {{ dy_expr }}
dist = 0
stride_dy = {{ sdy_expr if sdy_expr else 'dy * stride' }}
yp_xm_off = stride_dy - 1
yp_xp_off = stride_dy + 1
idx = node
if nx == gx:
    while True:
        idx += stride_dy
        dist += 1
        if cost[idx] is INF:
            dist = -1
            break
        if (
            idx == goal
            or (cost[idx - 1] is INF and cost[idx + yp_xm_off] is not INF)
            or (cost[idx + 1] is INF and cost[idx + yp_xp_off] is not INF)
        ):
            break
else:
    while True:
        idx += stride_dy
        dist += 1
        if cost[idx] is INF:
            dist = -1
            break
        if (cost[idx - 1] is INF and cost[idx + yp_xm_off] is not INF) or (
            cost[idx + 1] is INF and cost[idx + yp_xp_off] is not INF
        ):
            break
if dist > 0:
    nd = g_node + dist
    if nd < g[idx]:
        g[idx] = nd
        parent[idx] = {{ parent_expr }}
        entry_dir[idx] = dy + 4  # encodes (0, dy): (dx+1)*3 + (dy+1)
        hxh = abs(nx - gx)
        hyh = abs((idx // stride) - gy)
        hj = {{ max2('hxh', 'hyh') }}
        {{ push_line }}
{%- endmacro %}

{# Horizontal cardinal jump: dx = dx_expr, dy = 0. Caller provides `node`
   and `ny` (for goal-split and hyh).
   Uses precomputed offsets for forced-neighbor diagonals. #}
{% macro jump_h(dx_expr, parent_expr, push_line) -%}
dx = {{ dx_expr }}
dist = 0
up_off = -stride
up_dx_off = dx - stride
dn_off = stride
dn_dx_off = stride + dx
idx = node
if ny == gy:
    while True:
        idx += dx
        dist += 1
        if cost[idx] is INF:
            dist = -1
            break
        if (
            idx == goal
            or (cost[idx + up_off] is INF and cost[idx + up_dx_off] is not INF)
            or (cost[idx + dn_off] is INF and cost[idx + dn_dx_off] is not INF)
        ):
            break
else:
    while True:
        idx += dx
        dist += 1
        if cost[idx] is INF:
            dist = -1
            break
        if (cost[idx + up_off] is INF and cost[idx + up_dx_off] is not INF) or (
            cost[idx + dn_off] is INF and cost[idx + dn_dx_off] is not INF
        ):
            break
if dist > 0:
    nd = g_node + dist
    if nd < g[idx]:
        g[idx] = nd
        parent[idx] = {{ parent_expr }}
        entry_dir[idx] = 3 * dx + 4  # encodes (dx, 0): (dx+1)*3 + 1
        hxh = abs((idx % stride) - gx)
        hyh = abs(ny - gy)
        hj = {{ max2('hxh', 'hyh') }}
        {{ push_line }}
{%- endmacro %}

{# Diagonal jump: dx = dx_expr, dy = dy_expr, both nonzero.
   Optional `sdy_expr`: expression for stride_dy (avoids recomputing `dy * stride`). #}
{% macro jump_d(dx_expr, dy_expr, parent_expr, push_line, sdy_expr=None) -%}
dx = {{ dx_expr }}
dy = {{ dy_expr }}
dist = 0
stride_dy = {{ sdy_expr if sdy_expr else 'dy * stride' }}
step = stride_dy + dx
# Forced-neighbor offsets (main diagonal loop):
fwd_yx_off = stride_dy - dx    # (x-dx, y+dy) from idx
back_xy_off = dx - stride_dy   # (x+dx, y-dy) from idx
# Sub-scan (dx, 0) offsets: perpendicular rows y±1.
sub_up_dx_off = dx - stride
sub_dn_dx_off = stride + dx
# Sub-scan (0, dy) offsets: perpendicular cols x±1, one step along dy.
sub_yp_xm_off = stride_dy - 1
sub_yp_xp_off = stride_dy + 1
idx = node
while True:
    idx += step
    dist += 1
    if cost[idx] is INF:
        dist = -1
        break
    if (
        idx == goal
        or (cost[idx - dx] is INF and cost[idx + fwd_yx_off] is not INF)
        or (cost[idx - stride_dy] is INF and cost[idx + back_xy_off] is not INF)
    ):
        break
    # Sub-scan cardinal (dx, 0) from idx: y is fixed here.
    cidx = idx
    subfound = False
    while True:
        cidx += dx
        if cost[cidx] is INF:
            break
        if (
            cidx == goal
            or (cost[cidx - stride] is INF and cost[cidx + sub_up_dx_off] is not INF)
            or (cost[cidx + stride] is INF and cost[cidx + sub_dn_dx_off] is not INF)
        ):
            subfound = True
            break
    if subfound:
        break
    # Sub-scan cardinal (0, dy) from idx: x is fixed here.
    cidx = idx
    subfound = False
    while True:
        cidx += stride_dy
        if cost[cidx] is INF:
            break
        if (
            cidx == goal
            or (cost[cidx - 1] is INF and cost[cidx + sub_yp_xm_off] is not INF)
            or (cost[cidx + 1] is INF and cost[cidx + sub_yp_xp_off] is not INF)
        ):
            subfound = True
            break
    if subfound:
        break
if dist > 0:
    nd = g_node + dist
    if nd < g[idx]:
        g[idx] = nd
        parent[idx] = {{ parent_expr }}
        entry_dir[idx] = 3 * dx + dy + 4  # (dx+1)*3 + (dy+1)
        hxh = abs((idx % stride) - gx)
        hyh = abs((idx // stride) - gy)
        hj = {{ max2('hxh', 'hyh') }}
        {{ push_line }}
{%- endmacro %}

{# Unroll start-node expansion: 8 jumps, specialized per direction. #}
{% macro expand_start(parent_expr, push_line) -%}
{{ jump_v('-1', parent_expr, push_line) }}
{{ jump_d('1', '-1', parent_expr, push_line) }}
{{ jump_h('1', parent_expr, push_line) }}
{{ jump_d('1', '1', parent_expr, push_line) }}
{{ jump_v('1', parent_expr, push_line) }}
{{ jump_d('-1', '1', parent_expr, push_line) }}
{{ jump_h('-1', parent_expr, push_line) }}
{{ jump_d('-1', '-1', parent_expr, push_line) }}
{%- endmacro %}

{# Unroll diagonal-arrival successors. All cost checks use node + offset. #}
{% macro expand_diagonal_arrival(parent_expr, push_line) -%}
stride_dy0 = dy0 * stride
neg_stride_dy0 = -stride_dy0
if cost[node + stride_dy0] is not INF:
    {{ jump_v('dy0', parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node + dx0] is not INF:
    {{ jump_h('dx0', parent_expr, push_line) | indent(4) }}
if cost[node + stride_dy0 + dx0] is not INF:
    {{ jump_d('dx0', 'dy0', parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node - dx0] is INF and cost[node + stride_dy0 - dx0] is not INF:
    {{ jump_d('-dx0', 'dy0', parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node - stride_dy0] is INF and cost[node + dx0 - stride_dy0] is not INF:
    {{ jump_d('dx0', '-dy0', parent_expr, push_line, 'neg_stride_dy0') | indent(4) }}
{%- endmacro %}

{# Unroll horizontal-cardinal-arrival successors (dy0 == 0). #}
{% macro expand_horizontal_arrival(parent_expr, push_line) -%}
if cost[node + dx0] is not INF:
    {{ jump_h('dx0', parent_expr, push_line) | indent(4) }}
if cost[node - stride] is INF and cost[node - stride + dx0] is not INF:
    {{ jump_d('dx0', '-1', parent_expr, push_line) | indent(4) }}
if cost[node + stride] is INF and cost[node + stride + dx0] is not INF:
    {{ jump_d('dx0', '1', parent_expr, push_line) | indent(4) }}
{%- endmacro %}

{# Unroll vertical-cardinal-arrival successors (dx0 == 0). #}
{% macro expand_vertical_arrival(parent_expr, push_line) -%}
stride_dy0 = dy0 * stride
if cost[node + stride_dy0] is not INF:
    {{ jump_v('dy0', parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node - 1] is INF and cost[node + stride_dy0 - 1] is not INF:
    {{ jump_d('-1', 'dy0', parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node + 1] is INF and cost[node + stride_dy0 + 1] is not INF:
    {{ jump_d('1', 'dy0', parent_expr, push_line, 'stride_dy0') | indent(4) }}
{%- endmacro %}
