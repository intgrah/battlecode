{# Shared dispatch wrappers. Primitive jump_v/jump_h/jump_d live in flavor-specific
   modules: _macros_ray.j2 (ray-walking for JPS/JPS-Dial) or _macros_plus.j2
   (precomputed jump tables for JPS+). Callers import the flavor as `prim` and
   pass it to each dispatcher. Both flavors use interchangeable signatures.

   Each dispatcher accepts optional `dx0=`/`dy0=` kwargs that default to the
   runtime variable names `'dx0'`/`'dy0'` (used by ray JPS, which decodes them
   from `entry_dir[node]` once per pop). Callers that unroll the arrival axis
   (e.g. JPS+ monomorphises into 8 cases) can pass literals like `'1'` / `'-1'`
   so jump primitives receive compile-time directions — letting plus's `_tab()`
   resolve to direct table names rather than the 9-slot `jump_tabs[...]`. #}

{# Inline ternary max — ~4x faster than max() builtin for 2 args.
   File-level `# ruff: noqa: FURB136` is set in the generated output. #}
{% macro max2(a, b) -%}
({{ a }} if {{ a }} > {{ b }} else {{ b }})
{%- endmacro %}

{# Template-time negation for literal directions. When x is a runtime variable
   name (e.g. 'dx0'), returns '-dx0' (a Python unary-minus expression). When x
   is a literal like '1' or '-1', returns the opposite literal — keeping
   downstream specialisation (direct table names, constant folding) alive. #}
{% macro _neg(x) -%}
{%- if x == '-1' -%}1
{%- elif x == '1' -%}-1
{%- elif x == '0' -%}0
{%- else -%}-{{ x }}
{%- endif -%}
{%- endmacro %}

{# Template-time multiply with literal folding:
   mul('1', x) → x        mul(x, '1') → x
   mul('-1', x) → -x       mul(x, '-1') → -x
   mul('0', _) → 0         otherwise → 'a * b'. Saves runtime `1 * var` and
   `-1 * var` ops in monomorphised bodies (Python does not peephole these,
   since one operand is a variable). #}
{% macro mul(a, b) -%}
{%- if a == '1' -%}{{ b }}
{%- elif a == '-1' -%}-{{ b }}
{%- elif b == '1' -%}{{ a }}
{%- elif b == '-1' -%}-{{ a }}
{%- elif a == '0' or b == '0' -%}0
{%- else -%}{{ a }} * {{ b }}
{%- endif -%}
{%- endmacro %}

{# Unroll start-node expansion: 8 jumps, specialized per direction. #}
{% macro expand_start(prim, parent_expr, push_line) -%}
{{ prim.jump_v('-1', parent_expr, push_line) }}
{{ prim.jump_d('1', '-1', parent_expr, push_line) }}
{{ prim.jump_h('1', parent_expr, push_line) }}
{{ prim.jump_d('1', '1', parent_expr, push_line) }}
{{ prim.jump_v('1', parent_expr, push_line) }}
{{ prim.jump_d('-1', '1', parent_expr, push_line) }}
{{ prim.jump_h('-1', parent_expr, push_line) }}
{{ prim.jump_d('-1', '-1', parent_expr, push_line) }}
{%- endmacro %}

{# Unroll diagonal-arrival successors. All cost checks use node + offset.
   nx/ny are computed lazily only when the guarded jump actually runs. #}
{% macro expand_diagonal_arrival(prim, parent_expr, push_line, dx0='dx0', dy0='dy0') -%}
stride_dy0 = {{ mul(dy0, 'stride') }}
if cost[node + stride_dy0] is not inf:
    nx = node % stride
    {{ prim.jump_v(dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node + {{ dx0 }}] is not inf:
    ny = node // stride
    {{ prim.jump_h(dx0, parent_expr, push_line) | indent(4) }}
if cost[node + stride_dy0 + {{ dx0 }}] is not inf:
    {{ prim.jump_d(dx0, dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node - {{ dx0 }}] is inf and cost[node + stride_dy0 - {{ dx0 }}] is not inf:
{% if dx0 == 'dx0' %}
    ndx0 = -dx0
    {{ prim.jump_d('ndx0', dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
{% else %}
    {{ prim.jump_d(_neg(dx0), dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
{% endif %}
if cost[node - stride_dy0] is inf and cost[node + {{ dx0 }} - stride_dy0] is not inf:
    {{ prim.jump_d(dx0, _neg(dy0), parent_expr, push_line, '-stride_dy0') | indent(4) }}
{%- endmacro %}

{# Unroll horizontal-cardinal-arrival successors (dy0 == 0). #}
{% macro expand_horizontal_arrival(prim, parent_expr, push_line, dx0='dx0') -%}
if cost[node + {{ dx0 }}] is not inf:
    ny = node // stride
    {{ prim.jump_h(dx0, parent_expr, push_line) | indent(4) }}
if cost[node - stride] is inf and cost[node - stride + {{ dx0 }}] is not inf:
    {{ prim.jump_d(dx0, '-1', parent_expr, push_line) | indent(4) }}
if cost[node + stride] is inf and cost[node + stride + {{ dx0 }}] is not inf:
    {{ prim.jump_d(dx0, '1', parent_expr, push_line) | indent(4) }}
{%- endmacro %}

{# Unroll vertical-cardinal-arrival successors (dx0 == 0). #}
{% macro expand_vertical_arrival(prim, parent_expr, push_line, dy0='dy0') -%}
stride_dy0 = {{ mul(dy0, 'stride') }}
if cost[node + stride_dy0] is not inf:
    nx = node % stride
    {{ prim.jump_v(dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node - 1] is inf and cost[node + stride_dy0 - 1] is not inf:
    {{ prim.jump_d('-1', dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
if cost[node + 1] is inf and cost[node + stride_dy0 + 1] is not inf:
    {{ prim.jump_d('1', dy0, parent_expr, push_line, 'stride_dy0') | indent(4) }}
{%- endmacro %}
