class AstarJpsMpsp(Mpsp):
    REQUIRES = frozenset({COST})

    @override
    def __init__(self, ctx: PrecompCtx) -> None:
        w, h = ctx.w, ctx.h
        cost = ctx[COST]
        stride = w + 1
        n_pad = stride * (h + 1)
        cost_pad = [INF] * n_pad
        for y in range(h):
            for x in range(w):
                cost_pad[y * stride + x] = cost[y * w + x]
        self.w = w
        self.stride = stride
        self.n_pad = n_pad
        self.cost_pad = cost_pad
        # All 8 tables start uncomputed. No ray walks, no JP checks — nothing
        # map-wide happens here. Cells are filled during plan() calls only.
        self.jN = [-1] * n_pad
        self.jNE = [-1] * n_pad
        self.jE = [-1] * n_pad
        self.jSE = [-1] * n_pad
        self.jS = [-1] * n_pad
        self.jSW = [-1] * n_pad
        self.jW = [-1] * n_pad
        self.jNW = [-1] * n_pad

    @override
    def plan(self, start: int, goal: int) -> Path_:
        w = self.w
        sp = (start // w) * self.stride + (start % w)
        gp = (goal // w) * self.stride + (goal % w)
