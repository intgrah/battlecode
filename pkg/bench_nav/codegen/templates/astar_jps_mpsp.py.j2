def _reconstruct(
    parent: list[int], start: int, goal: int, stride: int, w: int
) -> list[int]:
    chain: list[int] = []
    cur = goal
    while cur != start:
        chain.append(cur)
        cur = parent[cur]
    chain.reverse()
    ax, ay = start % stride, start // stride
    path: list[int] = [ay * w + ax]
    for b in chain:
        bx, by = b % stride, b // stride
        dx = (bx > ax) - (bx < ax)
        dy = (by > ay) - (by < ay)
        while ax != bx or ay != by:
            ax += dx
            ay += dy
            path.append(ay * w + ax)
    return path


# === Lazy fill helpers ===================================================
# Each walks the ray from `t`, collecting uncomputed cells into `path`, stops
# at the first wall / cached cell / JP, then back-fills `path` in reverse so
# every touched cell gets its final distance-to-next-JP value.

def _fill_jN(t: int, jN: list[int], stride: int, cost: list[int]) -> None:
    if jN[t] >= 0:
        return
    inf = INF
    stride_dy = -stride
    path: list[int] = []
    idx = t
    result = 0
    while True:
        path.append(idx)
        f_idx = idx + stride_dy
        if cost[f_idx] is inf:
            break
        # Check JP at f_idx BEFORE consulting cached jN[f_idx] — the cached
        # value is "distance from f_idx to next JP going N" and doesn't
        # encode whether f_idx itself is a JP.
        if (cost[f_idx + 1] is inf and cost[f_idx + 1 + stride_dy] is not inf) or (
            cost[f_idx - 1] is inf and cost[f_idx - 1 + stride_dy] is not inf
        ):
            result = 1
            break
        if jN[f_idx] >= 0:
            result = jN[f_idx] + 1 if jN[f_idx] > 0 else 0
            break
        idx = f_idx
    v = result
    for c in reversed(path):
        jN[c] = v
        v = v + 1 if v > 0 else 0


