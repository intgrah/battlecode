[Unit]
Description=HITL annotation service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/hitl
Environment=HITL_DATA=%h/hitl/data
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --project %h/hitl/src hitl serve --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/hitl/hitl.log
StandardError=append:%h/hitl/hitl.log

[Install]
WantedBy=default.target
